# Template file for 'linux6.16-sdm845'
pkgname=linux6.16-sdm845
version=6.16.7
revision=9
_tag="sdm845-6.16.7-r0"
short_desc="Linux kernel and modules (${version%.*} series for OnePlus 6t)"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-2.0-only"
homepage="https://www.kernel.org"
distfiles="https://gitlab.com/sdm845-mainline/linux/-/archive/${_tag}/linux-${_tag}.tar.gz"

checksum="a9ce2fde510261d38f809e543abe4e90fbfd3a4e7a3eee3ea4a84b68d2d7d811"

python_version=3

archs="aarch64*"

nodebug=yes
nostrip=yes
noverifyrdeps=yes
noshlibprovides=yes
preserve=yes

hostmakedepends="tar xz bc elfutils-devel flex findutils gmp-devel kmod libmpc-devel
 pkg-config openssl-devel perl uboot-mkimage cpio pahole python3 zstd
 clang lld llvm"

_localversion="sdm845"
_kernver="${version}-${_localversion}"
triggers="kernel-hooks"
kernel_hooks_version="${_kernver}"

mutable_files="
 /usr/lib/modules/${_kernver}/modules.builtin.bin
 /usr/lib/modules/${_kernver}/modules.builtin.alias.bin
 /usr/lib/modules/${_kernver}/modules.softdep
 /usr/lib/modules/${_kernver}/modules.dep
 /usr/lib/modules/${_kernver}/modules.dep.bin
 /usr/lib/modules/${_kernver}/modules.symbols
 /usr/lib/modules/${_kernver}/modules.symbols.bin
 /usr/lib/modules/${_kernver}/modules.alias
 /usr/lib/modules/${_kernver}/modules.alias.bin
 /usr/lib/modules/${_kernver}/modules.devname"

export KBUILD_BUILD_TIMESTAMP=$(LC_ALL=C date -ud @${SOURCE_DATE_EPOCH:-0})
export KBUILD_BUILD_USER=voidlinux
export KBUILD_BUILD_HOST=voidlinux

if [ "$CROSS_BUILD" ]; then
	_cross="CROSS_COMPILE=${XBPS_CROSS_TRIPLET}-"
fi

do_configure() {
    local arch
    arch=arm64
    
    cp -f ${FILESDIR}/sdm845.config .config
    
    sed -i '/^CONFIG_CMDLINE=/d;/^# CONFIG_CMDLINE is not set/d' .config
    sed -i '/^CONFIG_CMDLINE_FORCE=/d;/^# CONFIG_CMDLINE_FORCE is not set/d' .config
    
    echo 'CONFIG_CMDLINE="root=PARTLABEL=userdata rootfstype=ext4 rw console=ttyMSM0 115200 noquiet console=tty0 loglevel=7 keep_bootcon"' >> .config
    echo 'CONFIG_CMDLINE_FORCE=y' >> .config
    #echo 'CONFIG_QCOM_PD_MAPPER=y' >> .config
    
    make ARCH=$arch ${_cross} LLVM=1 olddefconfig
}

do_build() {
	local arch _args
	arch=arm64

	export LDFLAGS=
	
	make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 prepare
	_args="Image modules dtbs"
	make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 ${_args}
	
	if grep -q '^CONFIG_EFI_ZBOOT=y' .config; then
		make ARCH=$arch ${_cross} ${makejobs} LLVM=1 LLVM_IAS=1 vmlinuz.efi
	fi
}

do_install() {
	local arch _args hdrdest dtb_dest
	arch=arm64

	sed -i '2iexit 0' scripts/depmod.sh
	vmkdir usr/lib
	ln -s usr/lib/ ${DESTDIR}

	make ${makejobs} ARCH=${arch} LLVM=1 INSTALL_MOD_PATH=${DESTDIR} ${_cross} \
		INSTALL_MOD_STRIP=1 modules_install

	hdrdest=${DESTDIR}/usr/src/kernel-headers-${_kernver}

	vinstall .config 644 boot config-${_kernver}
	vinstall System.map 644 boot System.map-${_kernver}
	vinstall arch/arm64/boot/Image 644 boot vmlinux-${_kernver}
	
	if [ -e "arch/arm64/boot/Image.gz" ]; then
		vinstall arch/arm64/boot/Image.gz 644 boot vmlinux-${_kernver}.gz
	else
		gzip -c -k -f arch/arm64/boot/Image > ${DESTDIR}/boot/vmlinux-${_kernver}.gz
	fi
	
	if [ -e "arch/arm64/boot/vmlinuz.efi" ]; then
		vinstall arch/arm64/boot/vmlinuz.efi 644 boot vmlinux-${_kernver}.efi
	fi

	dtb_dest=${DESTDIR}/boot/dtbs/dtbs-${_kernver}
	mkdir -p ${dtb_dest}
	
	make ${makejobs} ARCH=${arch} LLVM=1 INSTALL_DTBS_PATH=${dtb_dest} ${_cross} dtbs_install
	
	if [ ! -f "${dtb_dest}/qcom/sdm845-oneplus-fajita.dtb" ]; then
		echo "Warning: sdm845-oneplus-fajita.dtb not found, checking alternatives..."
		for dtb in ${dtb_dest}/qcom/sdm845-*.dtb; do
			if [ -f "$dtb" ]; then
				ln -sf $(basename "$dtb") ${dtb_dest}/qcom/sdm845-oneplus-fajita.dtb 2>/dev/null || true
				echo "Created symlink from $(basename "$dtb") to sdm845-oneplus-fajita.dtb"
				break
			fi
		done
	fi

	vmkdir usr

	cd ${DESTDIR}/usr/lib/modules/${_kernver}
	rm -f source build
	ln -sf ../../../src/kernel-headers-${_kernver} build

	cd ${wrksrc}
	install -Dm644 Makefile ${hdrdest}/Makefile
	install -Dm644 Kbuild ${hdrdest}/Kbuild
	install -Dm644 kernel/Makefile ${hdrdest}/kernel/Makefile
	install -Dm644 .config ${hdrdest}/.config
	
	for file in $(find . -name Kconfig\*); do
		mkdir -p ${hdrdest}/$(dirname $file)
		install -Dm644 $file ${hdrdest}/${file}
	done
	
	for file in $(find arch/${arch} scripts -name module.lds -o -name Kbuild.platforms -o -name Platform); do
		mkdir -p ${hdrdest}/$(dirname $file)
		install -Dm644 $file ${hdrdest}/${file}
	done
	
	mkdir -p ${hdrdest}/include
	
	#rm -rf ${DESTDIR}/usr/lib/firmware

	for i in acpi asm-generic clocksource config crypto drm generated linux vdso \
		math-emu media net pcmcia scsi sound trace uapi video xen dt-bindings; do
		if [ -d include/$i ]; then
			cp -a include/$i ${hdrdest}/include
		fi
	done

	cd ${wrksrc}
	mkdir -p ${hdrdest}/arch/${arch}
	cp -a arch/${arch}/include ${hdrdest}/arch/${arch}

	if [ "$CROSS_BUILD" ]; then
		make ${makejobs} ARCH=${arch} ${_cross} LLVM=1 _mrproper_scripts
		find scripts -name '*.o' -delete
	fi

	cp Module.symvers ${hdrdest}
	cp -a scripts ${hdrdest}
	
	mkdir -p ${hdrdest}/security/selinux
	cp -a security/selinux/include ${hdrdest}/security/selinux
	
	mkdir -p ${hdrdest}/tools/include
	cp -a tools/include/tools ${hdrdest}/tools/include
	
	if [ -d "arch/${arch}/tools" ]; then
		cp -a "arch/${arch}/tools" "${hdrdest}/arch/${arch}"
	fi
	
	cp -a kernel/time/timeconst.bc "${hdrdest}/kernel/time"
	cp -a kernel/bounds.c "${hdrdest}/kernel"

	mkdir -p ${hdrdest}/arch/${arch}/kernel
	cp arch/${arch}/Makefile ${hdrdest}/arch/${arch}

	mkdir -p ${hdrdest}/arch/arm64/kernel
	cp arch/arm64/kernel/asm-offsets.s ${hdrdest}/arch/arm64/kernel
	cp -a arch/arm64/kernel/vdso ${hdrdest}/arch/arm64/kernel/

	mkdir -p ${hdrdest}/drivers/md
	cp drivers/md/*.h ${hdrdest}/drivers/md

	mkdir -p ${hdrdest}/include/linux
	cp include/linux/inotify.h ${hdrdest}/include/linux

	mkdir -p ${hdrdest}/net/mac80211/
	cp net/mac80211/*.h ${hdrdest}/net/mac80211

	mkdir -p ${hdrdest}/fs/xfs/libxfs
	mkdir -p ${hdrdest}/mm
	cp fs/xfs/libxfs/xfs_sb.h ${hdrdest}/fs/xfs/libxfs/xfs_sb.h

	install -Dm644 vmlinux ${DESTDIR}/usr/lib/debug/boot/vmlinux-${_kernver}

	depmod -b ${DESTDIR}/usr -F System.map ${_kernver}
	rm -f ${DESTDIR}/lib
	
	mkdir -p ${DESTDIR}/usr/share/kernel/${pkgname}
	install -Dm644 include/config/kernel.release \
		${DESTDIR}/usr/share/kernel/${pkgname}/kernel.release
}
