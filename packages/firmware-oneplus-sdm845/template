# Template file for 'firmware-oneplus-sdm845'
pkgname=firmware-oneplus-sdm845
version=10
revision=1
wrksrc="firmware-oneplus-sdm845-${commit}"
depends="linux-firmware-qualcomm linux-firmware-network"
short_desc="Firmware for OnePlus 6 / 6T"
maintainer="Arseniy <me@adomerle.pw>"
license="proprietary"
homepage="https://gitlab.com/sdm845-mainline/firmware-oneplus-sdm845"
commit="176ca713448c5237a983fb1f158cf3a5c251d775"
distfiles="https://gitlab.com/sdm845-mainline/firmware-oneplus-sdm845/-/archive/${commit}/firmware-oneplus-sdm845-${commit}.tar.gz"
checksum=e2b96870faaec34b9b750638affb2c4794df275fe35dee3e839cb1d6332ce99c
archs="aarch64"
nostrip=1
ignore_elf_dirs="/usr/share/qcom"
noshlibprovides=yes
noverifyrdeps=yes

do_install() {
    # 1. QCOM прошивка (самая важная - GPU, модем, DSP)
    for firmware in $(cat ${FILESDIR}/qcom_firmware.files); do
        [ -z "$firmware" ] && continue
        firmware="${firmware#./}"
        
        if [ ! -f "${wrksrc}/${firmware}" ]; then
            msg_warn "QCOM file not found: ${firmware}"
            continue
        fi
        
        vinstall "${wrksrc}/${firmware}" 0644 usr/lib/firmware/qcom/sdm845/oneplus6
    done
    
    # 2. Postmarketos прошивка (аудио, WiFi) - просто в общую папку
    for firmware in $(cat ${FILESDIR}/postmarketos_firmware.files); do
        [ -z "$firmware" ] && continue
        firmware="${firmware#./}"
        
        if [ ! -f "${wrksrc}/${firmware}" ]; then
            msg_warn "PostmarketOS file not found: ${firmware}"
            continue
        fi
        
        vinstall "${wrksrc}/${firmware}" 0644 usr/lib/firmware
    done
    
    # 3. QCA прошивка (Bluetooth, WiFi)
    for firmware in $(cat ${FILESDIR}/qca_firmware.files); do
        [ -z "$firmware" ] && continue
        firmware="${firmware#./}"
        
        if [ ! -f "${wrksrc}/${firmware}" ]; then
            msg_warn "QCA file not found: ${firmware}"
            continue
        fi
        
        vinstall "${wrksrc}/${firmware}" 0644 usr/lib/firmware/qca/oneplus6
    done
    
    # 4. Сенсорные файлы (DSP библиотеки, конфиги сенсоров)
    for firmware in $(cat ${FILESDIR}/sensor_firmware.files); do
        [ -z "$firmware" ] && continue
        firmware="${firmware#./}"
        
        if [ ! -f "${wrksrc}/${firmware}" ]; then
            msg_warn "Sensor file not found: ${firmware}"
            continue
        fi
        
        # Сохраняем структуру от oneplus6/
        # Пример: usr/share/qcom/sdm845/OnePlus/oneplus6/dsp/adsp/file.so
        # → usr/share/qcom/sdm845/OnePlus/oneplus6/dsp/adsp/
        if [[ "$firmware" == *oneplus6/* ]]; then
            # Убираем все до oneplus6/ включительно
            rel_path="${firmware#*oneplus6/}"
            dest_path="usr/share/qcom/sdm845/OnePlus/oneplus6/${rel_path}"
            dest_dir=$(dirname "$dest_path")
            vinstall "${wrksrc}/${firmware}" 0644 "$dest_dir"
        else
            msg_warn "Unexpected sensor file path: ${firmware}"
        fi
    done
    
    # 5. Создаем симлинки для моделей enchilada (OnePlus 6) и fajita (OnePlus 6T)
    
    # В /usr/lib/firmware/qcom/sdm845/OnePlus/
    if [ -d "${DESTDIR}/usr/lib/firmware/qcom/sdm845/OnePlus/oneplus6" ]; then
        (cd "${DESTDIR}/usr/lib/firmware/qcom/sdm845/OnePlus" &&
         ln -sf oneplus6 enchilada 2>/dev/null || true &&
         ln -sf oneplus6 fajita 2>/dev/null || true)
    fi
    
    # В /usr/share/qcom/sdm845/OnePlus/
    if [ -d "${DESTDIR}/usr/share/qcom/sdm845/OnePlus/oneplus6" ]; then
        (cd "${DESTDIR}/usr/share/qcom/sdm845/OnePlus" &&
         ln -sf oneplus6 enchilada 2>/dev/null || true &&
         ln -sf oneplus6 fajita 2>/dev/null || true)
    fi
}
